{
  "schema_version": "auv_odarrl_control_ppo.v1",
  "experiment": {
    "name": "pc_ppo_c3_random_realistic_alos_dade_stable",
    "arm": "PC",
    "seed": 91400,
    "output": "artifacts/lowlevel/pc_ppo_c3_random_realistic_dade_stable",
    "device": "cuda:0"
  },
  "environment": {
    "config": "configs/lowlevel/odarrl_control_pc_c3_random_realistic_v1.json",
    "num_envs": 2048,
    "max_episode_steps": null,
    "observation_schema": "pc_v1"
  },
  "base_policy": {
    "mode": "none",
    "checkpoint": null,
    "checkpoint_sha256": null
  },
  "vector_env": {
    "backend": "batch_torch",
    "physics_dtype": "float64",
    "projection_search_radius": 8,
    "compile_step": false,
    "compile_mode": "default",
    "validate_finite": false
  },
  "instrumentation": {
    "record_step_timings": true,
    "policy_metrics_sample_size": 8192,
    "write_iteration_records": true
  },
  "training": {
    "iterations": 48,
    "initial_residual_zero": false,
    "privileged_current_critic": false
  },
  "history": {
    "short_window": 10,
    "long_window": 50,
    "short_stride": 1,
    "long_stride": 1,
    "current_frame_dropout_prob": 0.0
  },
  "encoder": {
    "kind": "dual_horizon_transformer",
    "feature_dim": 64,
    "fusion_hidden": [128, 64],
    "output_dim": 64,
    "dropout": 0.0,
    "num_layers": 2,
    "num_heads": 4,
    "feedforward_dim": 128
  },
  "pc": {
    "d_z_total": 32,
    "n_in_reserved": 8,
    "n_z_reserved": 4,
    "state_encoder_hidden_dims": [128, 128],
    "dade_enabled": true
  },
  "runner": {
    "num_steps_per_env": 256,
    "save_interval": 10,
    "empirical_normalization": false,
    "logger": "tensorboard"
  },
  "policy": {
    "actor_hidden_dims": [256, 128],
    "critic_hidden_dims": [256, 128],
    "activation": "elu",
    "init_noise_std": 0.1,
    "noise_std_type": "scalar"
  },
  "algorithm": {
    "num_learning_epochs": 2,
    "num_mini_batches": 128,
    "clip_param": 0.05,
    "gamma": 0.99,
    "lam": 0.95,
    "value_loss_coef": 1.0,
    "entropy_coef": 0.0001,
    "learning_rate": 0.00005,
    "max_grad_norm": 1.0,
    "use_clipped_value_loss": true,
    "schedule": "adaptive",
    "desired_kl": 0.01,
    "normalize_advantage_per_mini_batch": false
  }
}
