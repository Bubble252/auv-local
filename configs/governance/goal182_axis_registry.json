      "AX_MODULE_SET": {
        "active_level_count": 5,
        "approved_at": "2026-11-16",
        "description": "预注册的辅助模块组合；不是任意模块开关的笛卡尔积。",
        "implementation_fields": {
          "direct_current_encoder": "actor_current_encoder_enabled=true; current estimate side channel is encoded and added to z_t",
          "privileged_critic": "pc.critic_path_dim=30",
          "temporal_or_history": "dade_enabled=true; short/long history tokens enter DualHorizonEncoder"
        },
        "levels": {
          "MS_FULL": {
            "components": {
              "direct_current_encoder": true,
              "privileged_critic": true,
              "temporal_or_history": true
            },
            "description": "时序/历史 + 直接 current side-channel encoder + privileged critic。",
            "priority": 1,
            "short_code": "MOD4"
          },
          "MS_NONE": {
            "components": {
              "direct_current_encoder": false,
              "privileged_critic": false,
              "temporal_or_history": false
            },
            "description": "不额外启用时序、current 或 privileged-critic 模块。",
            "priority": 5,
            "short_code": "MOD0"
          },
          "MS_TEMP": {
            "components": {
              "direct_current_encoder": false,
              "privileged_critic": false,
              "temporal_or_history": true
            },
            "description": "启用时序/历史输入（当前 canonical 为 DADE dual-horizon transformer，不是 GRU/LSTM）；不启用直接 current encoder 或 privileged critic。",
            "priority": 4,
            "short_code": "MOD1"
          },
          "MS_TEMP_CURRENT": {
            "components": {
              "direct_current_encoder": true,
              "privileged_critic": false,
              "temporal_or_history": true
            },
            "description": "时序/历史输入 + 直接 current side-channel encoder；不启用 privileged critic。",
            "priority": 2,
            "short_code": "MOD3"
          },
          "MS_TEMP_PRIV": {
            "components": {
              "direct_current_encoder": false,
              "privileged_critic": true,
              "temporal_or_history": true
            },
            "description": "时序/历史输入 + privileged critic。",
            "priority": 3,
            "short_code": "MOD2"
          }
        },
        "multiplicative": true,
        "paired_priority": [
          {
            "control": "MS_TEMP_CURRENT",
