            "d_model": 112,
            "ffn": 224,
            "heads": 4,
            "layers": 2
          }
        },
        "description": "Actor 本体的网络后端；不是历史 encoder 类型。",
        "levels": {
          "AB_MLP_M": {
            "allowed_actor_kinds": [
              "mlp",
              "token_mlp"
            ],
            "backend_family": "mlp",
