            "input_contracts": {
              "mlp": "fused",
              "token_mlp": "token_mean"
            },
            "requirements": [
              "actor/critic capacity must follow the Goal181 M pairing rule",
              "encoder.kind must not be used as an actor backend substitute",
              "token_mlp must use the same token set, order, width, and pooling as its paired transformer arm",
              "fused mlp is only a fused-token control, not the primary transformer control"
